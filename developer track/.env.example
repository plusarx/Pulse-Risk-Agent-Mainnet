# Pulse Risk · BNB: web app. Copy to .env.local and fill the four secrets.
# Generate each secret with:  openssl rand -hex 32

# ── Secrets ──
SESSION_SECRET=replace-with-openssl-rand-hex-32
KEYSTORE_SECRET=replace-with-openssl-rand-hex-32        # never change after launch: stored venue keys are encrypted with it
AGENT_API_TOKEN=replace-with-openssl-rand-hex-32        # must equal AGENT_API_TOKEN in agent/.env
RELAY_API_KEY=replace-with-your-relay-link-api-key

# ── Agent wiring ──
AGENT_BSC_ADDRESS=0x0000000000000000000000000000000000000000   # the agent wallet's address (from AGENT_BSC_PRIVATE_KEY)
AGENT_CHAT_URL=http://127.0.0.1:3200

# ── Docker / Lightsail: public hostname Caddy gets an HTTPS certificate for (an A record pointing at the
# instance's static IP, or <static-ip>.sslip.io if you have no domain). Not used by `npm run dev`. ──
DOMAIN=your-domain.example.com

# ── Storage ──
DB_PATH=./data/pulse-risk.db

# ── RPC (NEXT_PUBLIC_* reach the browser: use keyless public endpoints only) ──
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
NEXT_PUBLIC_ETH_RPC_URL=https://ethereum-rpc.publicnode.com
NEXT_PUBLIC_ARB_RPC_URL=https://arb1.arbitrum.io/rpc

# ── Price integrity (optional): Atlas Oracle pull API key. Without it the Atlas view is skipped (the other views still work). ──
ATLAS_API_KEY=
