# Pulse Risk · BNB: agent loop (npm start) and chat service (npm run chat). Copy to agent/.env and fill the secrets.
# Every setting not listed here has a safe default in src/config.ts.

# ── App API ──
APP_API_URL=http://localhost:3100                        # your deployed app URL in production
AGENT_API_TOKEN=replace-with-the-same-value-as-the-app   # must equal AGENT_API_TOKEN in the app's .env.local

# ── Network ──
AGENT_NETWORK=mainnet                                    # mainnet | testnet

# ── Safety: the agent sends nothing unless BOTH are set to go live ──
DRY_RUN=true                                             # set false to go live
ALLOW_LIVE=no                                            # set yes-i-understand to go live

# ── Agent wallet (gas on BNB Chain; same address on Ethereum for Derive deposits) ──
AGENT_BSC_PRIVATE_KEY=0xreplace-with-64-hex-chars        # keep in a secret manager; fund with ~0.002 BNB (+ ~0.0005 ETH for Derive)
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
RELAY_API_KEY=replace-with-your-relay-link-api-key

# ── LLM via OpenRouter ──
LLM_MODE=on
OPENROUTER_API_KEY=replace-with-your-openrouter-key
LLM_MODEL_ANALYST=anthropic/claude-sonnet-4.5
LLM_TIMEOUT_MS=20000                                     # trading decisions
CHAT_LLM_TIMEOUT_MS=75000                                # long chat answers

# ── Chat service (keep private: only the app calls it) ──
AGENT_CHAT_HOST=127.0.0.1
AGENT_CHAT_PORT=3200

# ── Local state ──
AGENT_DB_PATH=./data/agent.db
LOG_LEVEL=info

# ── Price integrity (optional): Atlas Oracle pull API key. Without it the Atlas view is skipped (the other views still work). ──
ATLAS_API_KEY=

# ── CoinMarketCap MCP key (optional, free Basic tier): enables the chat agent's stock event calendar and crypto market data. ──
CMC_API_KEY=
